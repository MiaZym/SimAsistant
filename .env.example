# Base URLs visible from inside the container.
# For docker on Linux, host.docker.internal is enabled via extra_hosts in docker-compose.yml.

# ── Сервис транскрибации ──
TRANSCRIBE_URL=http://host.docker.internal:8077/api/v1/transcribe
TRANSCRIBE_FILE_FIELD=file

# ── LLM провайдеры ──
# Ollama (нативный API)
DEFAULT_OLLAMA_URL=http://host.docker.internal:11434

# vLLM (OpenAI-совместимый API)
DEFAULT_VLLM_URL=http://host.docker.internal:8000
VLLM_API_KEY=

# Таймаут для LLM запросов (в секундах)
LLM_TIMEOUT_SEC=600

